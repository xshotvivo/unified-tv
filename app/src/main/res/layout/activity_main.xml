<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101318"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UTV LIVE"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="准备就绪 · 首个移动端工程验证版"
        android:textColor="#AAB4C3"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/streamUrlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="输入 HTTPS 直播流地址"
        android:inputType="textUri"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#8792A2"
        android:backgroundTint="#718096"
        android:padding="12dp" />

    <Button
        android:id="@+id/playButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="播放" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        app:show_buffering="when_playing"
        app:use_controller="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="当前验证范围：HTTPS 单流播放。M3U、EPG、频道库和备份功能正在排期。"
        android:textColor="#8792A2"
        android:textSize="12sp" />
</LinearLayout>
